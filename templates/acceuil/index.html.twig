{% extends 'base.html.twig' %}

{% block title %}Hello AcceuilController!{% endblock %}

{% block body %}
{% block stylesheets %}
    <link rel="stylesheet" href={{asset('css/acceuil.css')}}>
{% endblock %}
<div>
  <section class="hero">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <h1>Apprenez. Progressez. Réussissez.</h1>

                <p class="lead mt-4">
                    Développez vos compétences grâce à nos formations
                    en ligne accessibles à tous.
                </p>

                <div class="mt-4">
                    <a href={{path('app_formation')}} class="btn btn-primary btn-lg me-2">
                        Voir les formations
                    </a>

                    <a href={{path('app_formation')}} class="btn btn-outline-light btn-lg">
                        En savoir plus
                    </a>
                </div>
            </div>

            <div class="col-lg-6 text-center mt-5 mt-lg-0">
                <img
                    src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f"
                    class="img-fluid rounded shadow"
                    alt="Online learning"
                >
            </div>

        </div>
    </div>
</section>
<section id="courses" class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold text-black">Nos formations</h2>
            <p class="text-muted">
                Découvrez nos formations populaires
            </p>
        </div>

        <div id="courseCarousel"
             class="carousel slide"
             data-bs-ride="carousel">

            <!-- Indicators -->
            <div class="carousel-indicators">
                <button
                    type="button"
                    data-bs-target="#courseCarousel"
                    data-bs-slide-to="0"
                    class="active">
                </button>

                <button
                    type="button"
                    data-bs-target="#courseCarousel"
                    data-bs-slide-to="1">
                </button>

                <button
                    type="button"
                    data-bs-target="#courseCarousel"
                    data-bs-slide-to="2">
                </button>
            </div>

            <!-- Slides -->
            <div class="carousel-inner rounded shadow">

                <div class="carousel-item active">
                    <img
                        src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4"
                        class="d-block w-100"
                        alt="Programming course"
                    >

                    <div class="carousel-caption d-none d-md-block">
                        <h3>Développement Web</h3>
                        <p>
                            Apprenez HTML, CSS, JavaScript et les frameworks modernes.
                        </p>
                        <a href="#" class="btn btn-primary">
                            Découvrir
                        </a>
                    </div>
                </div>

                <div class="carousel-item">
                    <img
                        src="https://images.unsplash.com/photo-1555066931-4365d14bab8c"
                        class="d-block w-100"
                        alt="Programming"
                    >

                    <div class="carousel-caption d-none d-md-block">
                        <h3>PHP & Symfony</h3>
                        <p>
                            Construisez des applications web professionnelles
                            avec Symfony.
                        </p>
                        <a href="#" class="btn btn-primary">
                            Découvrir
                        </a>
                    </div>
                </div>

                <div class="carousel-item">
                    <img
                        src="https://images.unsplash.com/photo-1551288049-bebda4e38f71"
                        class="d-block w-100"
                        alt="Data analysis"
                    >

                    <div class="carousel-caption d-none d-md-block">
                        <h3>Data & Intelligence</h3>
                        <p>
                            Découvrez l'analyse de données et les nouvelles
                            technologies.
                        </p>
                        <a href="#" class="btn btn-primary">
                            Découvrir
                        </a>
                    </div>
                </div>

            </div>

            <!-- Previous -->
            <button
                class="carousel-control-prev"
                type="button"
                data-bs-target="#courseCarousel"
                data-bs-slide="prev">

                <span class="carousel-control-prev-icon"></span>
            </button>

            <!-- Next -->
            <button
                class="carousel-control-next"
                type="button"
                data-bs-target="#courseCarousel"
                data-bs-slide="next">

                <span class="carousel-control-next-icon"></span>
            </button>

        </div>
    </div>
</section>

<section id="features" class="py-5 bg-dark">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">Pourquoi nous choisir ?</h2>

            <p class="text-white">
                Une plateforme pensée pour votre réussite.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">

                        <div class="feature-icon mb-3">
                            🎓
                        </div>

                        <h4>Formations de qualité</h4>

                        <p class="text-muted">
                            Accédez à des contenus pédagogiques
                            conçus par des professionnels.
                        </p>

                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">

                        <div class="feature-icon mb-3">
                            💻
                        </div>

                        <h4>Apprentissage en ligne</h4>

                        <p class="text-muted">
                            Suivez vos cours depuis votre ordinateur,
                            tablette ou smartphone.
                        </p>

                    </div>
                </div>
            </div>


            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">

                        <div class="feature-icon mb-3">
                            🏆
                        </div>

                        <h4>Certificats</h4>

                        <p class="text-muted">
                            Obtenez des certificats pour valoriser
                            vos nouvelles compétences.
                        </p>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

</div>
{% endblock %}

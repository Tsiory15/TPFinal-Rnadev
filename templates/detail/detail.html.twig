{% extends 'base.html.twig' %}

{% block title %}En savoir plus{% endblock %}

{% block body %}
{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/detail.css') }}">
{% endblock %}
<div class="detail_main_container">
    <div class="card_main_container">
            <video src={{asset('assets/videos/' ~ singleFormation.videos)}} class='videos' height='530' width='100%' controls></video>
            <div class="info_container">
                <h3>
                    {{singleFormation.titre}}
                </h3>
                <p>
                    {{singleFormation.description}}
                </p>
                <a href={{asset('assets/fichiers/' ~ singleFormation.fichiers)}} download='fichier'>
                        {{singleFormation.fichiers}}
                </a>
            </div>
    </div>
    <div class="formation_list">
        {% for item in formation %}
           <a href={{path('app_detail',{id:id,formation:item.id})}} class='text-decoration-none formation_link'>
                {{item.titre}}
           </a>
        {% endfor %}
    </div>
</div>
</div>
{% endblock %}

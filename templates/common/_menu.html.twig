<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/menu.css') }}">
    {% endblock %}

</head>

<body>

    <nav class="menu_main_container">

        <a href="{{ path('app_accueil') }}" class="text-decoration-none">Accueil</a>

        <a href="{{ path('app_formation') }}" class="text-decoration-none">Formation</a>

        <a href="#" class="text-decoration-none">Contact</a>

        {% if app.user%}
            <p class='username'>
                {{app.user.userIdentifier}}
                <a href={{path('app_logout')}} class='text-decoration-none login_button'>
                Se déconnecter
                </a>
            </p>
            
        {% else %}
        <div class='goToLoginPage'>
            <a href={{path('app_registration')}} class='text-decoration-none register_button'>
                S'inscrire
            </a>
            <a href={{path('app_login')}} class="text-decoration-none login_button">
                    Se connecter
            </a>
        </div>
        {% endif %}

    </nav>

</body>

</html>
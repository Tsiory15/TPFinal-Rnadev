<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/menu.css') }}">
    {% endblock %}

</head>

<body>

    <nav class="menu_main_container">

        <a href="{{ path('app_accueil') }}" class="nav-link">Acceuil</a>

        <a href="{{ path('app_formation') }}" class="nav-link">Formation</a>

        <a href="#" class="nav-link">Contact</a>

        {% set username = app.session.get('_security.last_username','guest') %}
        {% if app.session.has('_security.last_username') %}
            <p class='username'>
                {{username}}
                <a href={{path('app_deconnexion')}} class='btn btn-secondary'>
                Se déconnecter
                </a>
            </p>
            
        {% else %}
            <a href="{{ path('app_connexion') }}" class="btn btn-primary goToLoginPage">
                    Se connecter
            </a>
        {% endif %}

    </nav>

</body>

</html>
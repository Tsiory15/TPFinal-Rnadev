{% extends 'base.html.twig' %}

{% block title %}Section Formation{% endblock %}

{% block body %}
{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/formation.css') }}">
{% endblock %}
<div class="formation_main_container">
    <div class="formation_filter">
        <div class='simple_container filter_list_container'>
        <select class='filter_list'>
            {% for item in listCateg %}
                    <option value="">
                        <a href="" class='nav-link'>{{item.nom}}</a>
                    </option>
            {% endfor %}
        </select>
        </div>
        <div class='simple_container'>
        <form action={{path('app_formation')}} method="post">
            <input type="search" name="search" id="" class="search" placeholder='Rechercher'>
            <input type="submit" value="Search" class='btn btn-primary'>
        </form>
        </div>
    </div>
    <div class="formation_card_container">
        {% for item in listModule %}
            <div class='formation_card'>
                <div class='formation_image_container'>
                    <img src={{asset('images/mob.jpeg')}} alt="" height='100%' width:'100%'>
                </div>
                <div class='second_container'>
                    <h5>
                        {{item.titre}}
                    </h5>
                    <a href={{path('app_detail',{id:item.id})}} class='formation_button'>Voir les détails</a>
                </div>
            </div>
    {% endfor %}
    </div>
    <div class="formation_pagination">
        <a href={{path('app_formation',{page:CurrentPage - 1})}} class='nav-link'>
            Précedent
        </a>
        <p class='nbr_page'>
            {{CurrentPage}}/{{totalItem}}
        <p/>
        <a href={{path('app_formation',{page:CurrentPage + 1})}} class='nav-link'>
            Suivant
        </a>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Section Formation{% endblock %}

{% block body %}
{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/formation.css') }}">
{% endblock %}
<div class="formation_main_container">
    <div class="formation_filter">
        Catégories
        <ul class='filter_list'>
            {% for item in listCateg %}
                <li>
                    <a href="" class='nav-link'>{{item.nom}}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
    <div class="formation_card_container">
        {% for item in listModule %}
            <div class='formation_card'>
                <div class='formation_image_container'>
                    <p>Image Container</p>
                </div>
                <div class='second_container'>
                    <h3>
                        {{item.titre}}
                    </h3>
                    <p>{{item.description}}</p>
                    <a href={{path('app_detail',{id:item.id})}} class='formation_button'>Voir les détails</a>
                </div>
            </div>
    {% endfor %}
    </div>
    <div class="formation_pagination">
        <a href="" class='nav-link'>
            Précedent
        </a>
        <p class='nbr_page'>
            1/1
        <p/>
        <a href="" class='nav-link'>
            Suivant
        </a>
    </div>
</div>
{% endblock %}

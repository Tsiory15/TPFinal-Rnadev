{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin_dashboard.css') }}">
{% endblock %}

{% block body %}

<div class="admin-dashboard">

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">

        <div class="admin-logo">
            <i class="fa-solid fa-user-tie"></i>
            <h2>Administration</h2>
        </div>

        <nav class="admin-sidebar-menu">

            <!-- Dashboard -->
            <a href="#" class="admin-menu-item active">
                <i class="fa-solid fa-house"></i>
                Dashboard
            </a>

            <!-- Gestion des formations -->
            <a href="{{ path('admin_formations') }}" class="admin-menu-item">
                <i class="fa-solid fa-book"></i>
                Gestion des formations
            </a>

        </nav>

        <!-- BAS SIDEBAR -->
        <div class="admin-sidebar-bottom">

            <a href="#" class="admin-menu-item">
                <i class="fa-solid fa-gear"></i>
                Paramètres
            </a>

            <a href="#" class="admin-menu-item">
                <i class="fa-solid fa-right-from-bracket"></i>
                Déconnexion
            </a>

        </div>

    </aside>


    <!-- CONTENU PRINCIPAL -->
    <main class="admin-main">

        <!-- HEADER -->
        <header class="admin-topbar">

            <div>
                <h1>Dashboard</h1>

                <p>
                    Bienvenue dans votre espace administrateur.
                </p>
            </div>


            <div class="admin-profile">

                <div class="admin-profile-info">

                    <strong>Professeur</strong>

                    <span>Administrateur</span>

                </div>

                <div class="admin-profile-avatar">
                    P
                </div>

            </div>

        </header>


        <!-- CONTENU -->
        <section class="admin-content">

            <h2>Vue d'ensemble</h2>


            <!-- STATISTIQUES -->
            <div class="admin-stats">

                <!-- FORMATIONS -->
                <div class="admin-stat-card">

                    <i class="fa-solid fa-book admin-stat-icon"></i>

                    <div>

                        <p>Formations</p>

                        <h3>12</h3>

                    </div>

                </div>


                <!-- ÉTUDIANTS -->
                <div class="admin-stat-card">

                    <i class="fa-solid fa-users admin-stat-icon"></i>

                    <div>

                        <p>Étudiants</p>

                        <h3>85</h3>

                    </div>

                </div>


                <!-- COURS -->
                <div class="admin-stat-card">

                    <i class="fa-solid fa-graduation-cap admin-stat-icon"></i>

                    <div>

                        <p>Cours</p>

                        <h3>36</h3>

                    </div>

                </div>

            </div>

        </section>

    </main>

</div>

{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Gestion des formations{% endblock %}

{% block stylesheets %} <link rel="stylesheet" href="{{ asset('css/crud_formations.css') }}">
{% endblock %}

{% block body %}

<div class="admin-dashboard">

    <main class="admin-main">

        <header class="admin-topbar">
            <h1>Gestion des formations</h1>
        </header>

        <section class="admin-content">

            <!-- FORMULAIRE -->

            <div class="formation-header">

                <div class="formation-title">
                    <h2>Ajouter une formation</h2>
                </div>

                {{ form_start(form, {
                    'attr': {
                        'class': 'formation-form'
                    }
                }) }}

                    <div class="form-group">
                        {{ form_label(form.titre) }}

                        {{ form_widget(form.titre, {
                            'attr': {
                                'placeholder': 'Ex : Développement Web'
                            }
                        }) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.description) }}

                        {{ form_widget(form.description, {
                            'attr': {
                                'placeholder': 'Description de la formation'
                            }
                        }) }}
                    </div>

                    <div class="form-actions">

                        <button type="submit" class="admin-btn">
                            <i class="fa-solid fa-plus"></i>
                            Ajouter la formation
                        </button>

                    </div>

                {{ form_end(form) }}

            </div>


            <!-- LISTE DES FORMATIONS -->

            <div class="formation-list">

                <h2>Liste des formations</h2>

                <div class="formations-table-container">

                    <table class="formations-table">

                        <thead>
                            <tr>
                                <th class="id-column">ID</th>
                                <th class="titre-column">Titre</th>
                                <th class="description-column">Description</th>
                                <th class="actions-column">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            {% for formation in formations %}

                                <tr>

                                    <td class="id-column">
                                        {{ formation.id }}
                                    </td>

                                    <td class="titre-column">
                                        {{ formation.titre }}
                                    </td>

                                    <td class="description-column">
                                        {{ formation.description }}
                                    </td>

                                    <td class="actions-column">

                                        <div class="formations-actions">

                                            <a href="{{ path('admin_formation_modifier', {'id': formation.id}) }}"
                                                class="btn-modifier">
                                                    Modifier
                                            </a>

                                            <form  
                                                method="post" action="{{ path('admin_formation_supprimer', {'id': formation.id}) }}"
                                                onsubmit="return confirm('Voulez-vous vraiment supprimer cette formation ?');">

                                                <button type="submit" class="btn-supprimer">
                                                    Supprimer
                                                </button>

                                            </form>
                                        


                                        </div>

                                    </td>

                                </tr>

                                {% else %}
                                <tr>
                                    <td colspan="4" class="empty-table">
                                        Aucune formation disponible.
                                    </td>
                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>


</div>

{% endblock %}
